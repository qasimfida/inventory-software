{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vitest*.ts",
    "apps/api/**/*.ts",
    "packages/**/*.test.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "tests/browser/**/*.ts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
