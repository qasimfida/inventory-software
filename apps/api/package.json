{
  "name": "@inventory/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --env-file-if-exists=.env dist/database/migrate-cli.js",
    "db:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "prebuild": "npm run build -w @inventory/contracts && npm run build -w @inventory/domain",
    "lint": "eslint .",
    "test": "node ../../scripts/test-workspace.mjs",
    "pretest": "npm run build -w @inventory/contracts",
    "pretypecheck": "npm run build -w @inventory/contracts && npm run build -w @inventory/domain",
    "start:local": "node --env-file-if-exists=.env dist/main.js",
    "start:production": "node ../../scripts/production.mjs api",
    "predb:migrate": "npm run build",
    "preauth:admin": "npm run build",
    "auth:admin": "node --env-file-if-exists=.env dist/auth/admin-cli.js",
    "predb:seed:dev": "npm run build",
    "db:seed:dev": "node --env-file-if-exists=.env dist/development/seed-cli.js"
  },
  "dependencies": {
    "@inventory/contracts": "0.0.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7",
    "@inventory/domain": "0.0.0"
  }
}
