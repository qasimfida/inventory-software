# Template only: replace placeholders and inject settings through the deployment environment.
NODE_ENV=production
HOST=0.0.0.0
PORT=3100
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@db.example.invalid:5432/inventory
DATABASE_SSL=verify-full
CORS_ORIGINS=https://app.example.invalid

# Bounded resources; tune for the deployment and reviewed migration duration.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
REQUEST_BODY_LIMIT_BYTES=102400
HTTP_REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=15000

# No provider adapter is installed. Credentials stay server-side.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=10000
AI_MAX_OUTPUT_TOKENS=512

# Diagnostic release identifier; no secrets. In-app notifications need no provider credentials.
APP_VERSION=0.0.0
