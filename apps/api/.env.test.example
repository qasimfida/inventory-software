# Test-only template. Unit tests inject their own fixtures; never use a production database.
NODE_ENV=test
HOST=127.0.0.1
PORT=3101
DATABASE_URL=postgresql://test@127.0.0.1:5434/inventory_test
DATABASE_SSL=disable
CORS_ORIGINS=http://localhost:8081

# Bounded resources; tune for the deployment and reviewed migration duration.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
REQUEST_BODY_LIMIT_BYTES=102400
HTTP_REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=15000
