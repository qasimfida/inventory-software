NODE_ENV=development
HOST=127.0.0.1
PORT=3100
# Local development only; npm run db:local provisions this isolated database.
DATABASE_URL=postgresql://inventory:local-development-only@127.0.0.1:5433/inventory
DATABASE_SSL=disable
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:8081,http://127.0.0.1:8081

# Bounded resources; tune for the deployment and reviewed migration duration.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000
REQUEST_BODY_LIMIT_BYTES=102400
HTTP_REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=15000

# AI foundation only; no provider adapter is installed. Keep disabled.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=10000
AI_MAX_OUTPUT_TOKENS=512

# Diagnostic release identifier; no secrets. In-app notifications need no provider credentials.
APP_VERSION=0.0.0
