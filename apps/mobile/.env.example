# Public origin only. Physical devices need a reachable LAN or HTTPS address.
# Android emulator uses 10.0.2.2; iOS simulator can use 127.0.0.1.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3100

# Optional development-only fixture transport. Never enable in production.
EXPO_PUBLIC_USE_MOCKS=false
# Existing production HTTPS web origin for invitation links (not the API URL).
# EXPO_PUBLIC_APP_ORIGIN=https://your-real-production-host
