{
  "name": "@inventory/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform android --platform ios --platform web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prebuild": "npm run build:shared --prefix ../..",
    "predev": "npm run build:shared --prefix ../..",
    "preandroid": "npm run build:shared --prefix ../..",
    "preios": "npm run build:shared --prefix ../..",
    "lint": "eslint .",
    "test": "node ../../scripts/test-workspace.mjs",
    "pretest": "npm run build:shared --prefix ../..",
    "pretypecheck": "npm run build:shared --prefix ../..",
    "build:production": "npm run build:shared --prefix ../.. && node ../../scripts/production.mjs mobile"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@inventory/api-client": "0.0.0",
    "@inventory/contracts": "0.0.0",
    "@inventory/design-tokens": "0.0.0",
    "@inventory/domain": "0.0.0",
    "expo": "58.0.16",
    "expo-camera": "~58.0.11",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-image-picker": "~58.0.10",
    "expo-print": "~58.0.7",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-web": "^0.21.4"
  }
}
