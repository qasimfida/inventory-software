{
  "expo": {
    "name": "Inventory Foundation",
    "slug": "inventory-foundation",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inventoryfoundation.app"
    },
    "android": {
      "package": "com.inventoryfoundation.app"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow barcode scanning for product and location lookup.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing"
    ],
    "scheme": "inventory"
  }
}
