# Public client configuration, never place credentials in VITE_* variables.
VITE_API_BASE_URL=http://127.0.0.1:3100

# Optional development-only fixture transport. Never enable in production.
VITE_USE_MOCKS=false
# Existing production HTTPS web origin for invitation links (not the API URL).
# VITE_APP_ORIGIN=https://your-real-production-host
