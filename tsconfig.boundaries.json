{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@inventory/contracts": ["./packages/contracts/src/index.ts"],
      "@inventory/api-client": ["./packages/api-client/src/index.ts"]
    }
